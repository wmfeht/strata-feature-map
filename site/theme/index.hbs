<!DOCTYPE HTML>
<html lang="{{ language }}" class="{{ default_theme }} sidebar-visible" dir="{{ text_direction }}">
    <head>
        <!-- Strata docs theme. Derived from mdBook 0.4.52's index.hbs: keep the ids and
             classes book.js and searcher.js look up when changing this file. -->
        <meta charset="UTF-8">
        <title>{{ title }}</title>
        {{#if is_print }}
        <meta name="robots" content="noindex">
        {{/if}}
        {{#if base_url}}
        <base href="{{ base_url }}">
        {{/if}}

        {{> head}}

        <meta name="description" content="{{ description }}">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#1a1b26">

        {{#if favicon_svg}}
        <link rel="icon" href="{{ resource "favicon.svg" }}" type="image/svg+xml">
        {{/if}}
        {{#if favicon_png}}
        <link rel="alternate icon" href="{{ resource "favicon.png" }}" type="image/png">
        {{/if}}
        {{#if copy_fonts}}
        <link rel="preload" href="{{ resource "fonts/jetbrains-mono-latin-wght-normal.woff2" }}" as="font" type="font/woff2" crossorigin>
        <link rel="stylesheet" href="{{ resource "fonts/fonts.css" }}">
        {{/if}}
        <link rel="stylesheet" href="{{ resource "css/variables.css" }}">
        <link rel="stylesheet" href="{{ resource "css/general.css" }}">
        <link rel="stylesheet" href="{{ resource "css/chrome.css" }}">
        {{#if print_enable}}
        <link rel="stylesheet" href="{{ resource "css/print.css" }}" media="print">
        {{/if}}

        <!-- FontAwesome still draws the search spinner. -->
        <link rel="stylesheet" href="{{ resource "FontAwesome/css/font-awesome.css" }}">

        <!-- book.js toggles these three by id. Only highlight.css carries the Tokyo Night
             palette; the other two stay disabled for every Strata theme. -->
        <link rel="stylesheet" id="highlight-css" href="{{ resource "highlight.css" }}">
        <link rel="stylesheet" id="tomorrow-night-css" href="{{ resource "tomorrow-night.css" }}" disabled>
        <link rel="stylesheet" id="ayu-highlight-css" href="{{ resource "ayu-highlight.css" }}" disabled>

        {{#each additional_css}}
        <link rel="stylesheet" href="{{ resource this }}">
        {{/each}}

        {{#if mathjax_support}}
        <script async src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.1/MathJax.js?config=TeX-AMS-MML_HTMLorMML"></script>
        {{/if}}

        <script>
            const path_to_root = "{{ path_to_root }}";
            const default_light_theme = "{{ default_theme }}";
            const default_dark_theme = "{{ preferred_dark_theme }}";
        {{#if search_js}}
            window.path_to_searchindex_js = "{{ resource "searchindex.js" }}";
        {{/if}}
        </script>
        <script src="{{ resource "toc.js" }}"></script>
    </head>
    <body>
    <div id="mdbook-help-container">
        <div id="mdbook-help-popup">
            <h2 class="mdbook-help-title">Keyboard shortcuts</h2>
            <dl>
                <dt><kbd>←</kbd> <kbd>→</kbd></dt><dd>Previous or next page</dd>
                {{#if search_enabled}}
                <dt><kbd>S</kbd> <kbd>/</kbd></dt><dd>Search</dd>
                {{/if}}
                <dt><kbd>?</kbd></dt><dd>Show this help</dd>
                <dt><kbd>Esc</kbd></dt><dd>Close</dd>
            </dl>
        </div>
    </div>
    <div id="body-container">
        <!-- Work around some values being stored in localStorage wrapped in quotes -->
        <script>
            try {
                let theme = localStorage.getItem('mdbook-theme');
                let sidebar = localStorage.getItem('mdbook-sidebar');

                if (theme.startsWith('"') && theme.endsWith('"')) {
                    localStorage.setItem('mdbook-theme', theme.slice(1, theme.length - 1));
                }

                if (sidebar.startsWith('"') && sidebar.endsWith('"')) {
                    localStorage.setItem('mdbook-sidebar', sidebar.slice(1, sidebar.length - 1));
                }
            } catch (e) { }
        </script>

        <!-- Set the theme before any content is loaded, prevents flash. A theme saved by
             an earlier stock mdBook theme ("navy", "light") falls back to the default. -->
        <script>
            const strata_themes = ["tokyo-night", "tokyo-night-storm", "tokyo-night-day"];
            const default_theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? default_dark_theme : default_light_theme;
            let theme;
            try { theme = localStorage.getItem('mdbook-theme'); } catch(e) { }
            if (!strata_themes.includes(theme)) { theme = default_theme; }
            const html = document.documentElement;
            html.classList.remove('{{ default_theme }}')
            html.classList.add(theme);
            html.classList.add("js");
        </script>

        <input type="checkbox" id="sidebar-toggle-anchor" class="hidden">

        <!-- Hide / unhide sidebar before it is displayed -->
        <script>
            let sidebar = null;
            const sidebar_toggle = document.getElementById("sidebar-toggle-anchor");
            if (document.body.clientWidth >= 1080) {
                try { sidebar = localStorage.getItem('mdbook-sidebar'); } catch(e) { }
                sidebar = sidebar || 'visible';
            } else {
                sidebar = 'hidden';
                sidebar_toggle.checked = false;
            }
            if (sidebar === 'visible') {
                sidebar_toggle.checked = true;
            } else {
                html.classList.remove('sidebar-visible');
            }
        </script>

        <!-- book.js moves #menu-bar with an inline `top`; chrome.css pins it instead. -->
        <header id="menu-bar" class="menu-bar topbar">
            <div class="topbar-inner">
                <label id="sidebar-toggle" class="icon-button" for="sidebar-toggle-anchor" title="Toggle table of contents" aria-label="Toggle table of contents" aria-controls="sidebar">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.5h12M2 8h12M2 12.5h12"/></svg>
                </label>
                <a class="brand" href="{{ path_to_root }}index.html" aria-label="Strata documentation home">
                    <svg class="brand-mark" viewBox="0 0 7 8" aria-hidden="true">
                        <path class="pixel-shadow" transform="translate(1 1)" d="M1 0h5v1h-5zM0 1h2v1h-2zM0 2h2v1h-2zM1 3h4v1h-4zM4 4h2v1h-2zM4 5h2v1h-2zM0 6h5v1h-5z"/>
                        <path class="pixel-face" d="M1 0h5v1h-5zM0 1h2v1h-2zM0 2h2v1h-2zM1 3h4v1h-4zM4 4h2v1h-2zM4 5h2v1h-2zM0 6h5v1h-5z"/>
                    </svg>
                </a>
                <span class="menu-title" title="Back to top">{{ book_title }}</span>
                <nav class="topnav" aria-label="Sections">
                    <a href="{{ path_to_root }}index.html" data-part="Guide">Guide</a>
                    <a href="{{ path_to_root }}index.html" data-part="Reference">Reference</a>
                </nav>

                <div class="topbar-actions">
                    {{#if search_enabled}}
                    <button id="search-toggle" class="icon-button search-button" type="button" title="Search (/)" aria-label="Toggle search" aria-expanded="false" aria-keyshortcuts="/ s" aria-controls="searchbar">
                        <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5 14 14"/></svg>
                        <span class="search-hint">Search</span>
                        <kbd>/</kbd>
                    </button>
                    {{/if}}
                    <div class="theme-menu">
                        <button id="theme-toggle" class="icon-button" type="button" title="Change theme" aria-label="Change theme" aria-haspopup="true" aria-expanded="false" aria-controls="theme-list">
                            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.75a6.25 6.25 0 1 0 0 12.5c.9 0 1.4-.6 1.4-1.3 0-.9-.7-1.2-.7-2 0-.8.6-1.3 1.4-1.3h1.6a2.55 2.55 0 0 0 2.55-2.55C14.25 4.2 11.45 1.75 8 1.75Z"/><circle class="fill" cx="4.75" cy="7.25" r=".9"/><circle class="fill" cx="6.75" cy="4.5" r=".9"/><circle class="fill" cx="10" cy="4.5" r=".9"/></svg>
                        </button>
                        <ul id="theme-list" class="theme-popup" aria-label="Themes" role="menu">
                            <li role="none"><button role="menuitem" class="theme" id="tokyo-night">Tokyo Night</button></li>
                            <li role="none"><button role="menuitem" class="theme" id="tokyo-night-storm">Storm</button></li>
                            <li role="none"><button role="menuitem" class="theme" id="tokyo-night-day">Day</button></li>
                        </ul>
                    </div>
                    {{#if print_enable}}
                    <a class="icon-button print-button" href="{{ path_to_root }}print.html" title="Print this book" aria-label="Print this book">
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 5.5v-4h7v4M4.5 11.5h-2.5v-6h12v6h-2.5M4.5 9.5h7v5h-7z"/></svg>
                    </a>
                    {{/if}}
                    {{#if git_repository_url}}
                    <a class="cta" href="{{git_repository_url}}">
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path class="fill" d="M8 .5a7.5 7.5 0 0 0-2.37 14.62c.38.07.51-.16.51-.36v-1.3c-2.09.45-2.53-.9-2.53-.9-.34-.87-.84-1.1-.84-1.1-.68-.46.05-.45.05-.45.76.05 1.15.77 1.15.77.67 1.15 1.76.82 2.19.63.07-.49.26-.82.48-1-1.67-.19-3.42-.83-3.42-3.71 0-.82.29-1.49.77-2.02-.08-.19-.33-.95.07-1.98 0 0 .63-.2 2.06.77a7.2 7.2 0 0 1 3.76 0c1.43-.97 2.06-.77 2.06-.77.41 1.03.15 1.79.07 1.98.48.53.77 1.2.77 2.02 0 2.89-1.76 3.52-3.43 3.71.27.23.51.69.51 1.39v2.06c0 .2.13.44.52.36A7.5 7.5 0 0 0 8 .5Z"/></svg>
                        GitHub
                    </a>
                    {{/if}}
                </div>
            </div>
        </header>

        {{#if search_enabled}}
        <div id="search-wrapper" class="hidden" role="dialog" aria-label="Search">
            <div class="search-palette">
                <form id="searchbar-outer" class="searchbar-outer">
                    <div class="search-wrapper">
                        <svg class="search-glyph" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5 14 14"/></svg>
                        <input type="search" id="searchbar" name="searchbar" placeholder="Search the docs" autocomplete="off" aria-controls="searchresults-outer" aria-describedby="searchresults-header">
                        <div class="spinner-wrapper">
                            <i class="fa fa-spinner fa-spin"></i>
                        </div>
                        <kbd class="search-esc">Esc</kbd>
                    </div>
                </form>
                <div id="searchresults-outer" class="searchresults-outer hidden">
                    <div id="searchresults-header" class="searchresults-header"></div>
                    <ul id="searchresults">
                    </ul>
                </div>
            </div>
        </div>
        {{/if}}

        <nav id="sidebar" class="sidebar" aria-label="Table of contents">
            <!-- populated by js -->
            <mdbook-sidebar-scrollbox class="sidebar-scrollbox"></mdbook-sidebar-scrollbox>
            <noscript>
                <iframe class="sidebar-iframe-outer" src="{{ path_to_root }}toc.html"></iframe>
            </noscript>
            <!-- book.js binds drag handlers here; the theme keeps the sidebar a fixed width. -->
            <div id="sidebar-resize-handle" class="sidebar-resize-handle" hidden></div>
        </nav>
        <label class="sidebar-scrim" for="sidebar-toggle-anchor" aria-hidden="true"></label>

        <!-- Point Guide and Reference at the first page of each part, and mark the current one. -->
        <script>
            (function () {
                const toc = document.querySelector('#sidebar .chapter');
                const here = document.querySelector('#sidebar a.active');
                let part = null;
                if (toc) {
                    toc.querySelectorAll('li').forEach(function (li) {
                        if (li.classList.contains('part-title')) {
                            part = li.textContent.trim();
                            li.setAttribute('data-part', part);
                            return;
                        }
                        const link = li.querySelector(':scope > a');
                        if (!link || !part) { return; }
                        const nav = document.querySelector('.topnav a[data-part="' + part + '"]:not([data-set])');
                        if (nav) { nav.href = link.href; nav.setAttribute('data-set', ''); }
                        if (link === here) {
                            document.documentElement.setAttribute('data-part', part);
                            const current = document.querySelector('.topnav a[data-part="' + part + '"]');
                            if (current) { current.setAttribute('aria-current', 'true'); }
                        }
                    });
                }
            })();
        </script>

        <div id="page-wrapper" class="page-wrapper">

            <div class="page">
                {{> header}}

                <!-- Apply ARIA attributes after the sidebar and the sidebar toggle button are added to the DOM -->
                <script>
                    document.getElementById('sidebar-toggle').setAttribute('aria-expanded', sidebar === 'visible');
                    document.getElementById('sidebar').setAttribute('aria-hidden', sidebar !== 'visible');
                    Array.from(document.querySelectorAll('#sidebar a')).forEach(function(link) {
                        link.setAttribute('tabIndex', sidebar === 'visible' ? 0 : -1);
                    });
                </script>

                <div id="content" class="content">
                    <div class="masthead" aria-hidden="true">
                        <svg class="wordmark" viewBox="0 0 42 8" role="presentation">
                            <defs>
                                <linearGradient id="wordmark-shade" x1="0" y1="0" x2="0" y2="7" gradientUnits="userSpaceOnUse">
                                    <stop offset="0" class="stop-1"/>
                                    <stop offset="0.43" class="stop-1"/>
                                    <stop offset="0.43" class="stop-2"/>
                                    <stop offset="0.715" class="stop-2"/>
                                    <stop offset="0.715" class="stop-3"/>
                                    <stop offset="1" class="stop-3"/>
                                </linearGradient>
                            </defs>
                            <path class="pixel-shadow" transform="translate(1 1)" d="M1 0h5v1h-5zM0 1h2v1h-2zM0 2h2v1h-2zM1 3h4v1h-4zM4 4h2v1h-2zM4 5h2v1h-2zM0 6h5v1h-5zM7 0h6v1h-6zM9 1h2v1h-2zM9 2h2v1h-2zM9 3h2v1h-2zM9 4h2v1h-2zM9 5h2v1h-2zM9 6h2v1h-2zM14 0h5v1h-5zM14 1h2v1h-2zM18 1h2v1h-2zM14 2h2v1h-2zM18 2h2v1h-2zM14 3h5v1h-5zM14 4h2v1h-2zM17 4h2v1h-2zM14 5h2v1h-2zM18 5h2v1h-2zM14 6h2v1h-2zM18 6h2v1h-2zM22 0h4v1h-4zM21 1h2v1h-2zM25 1h2v1h-2zM21 2h2v1h-2zM25 2h2v1h-2zM21 3h6v1h-6zM21 4h2v1h-2zM25 4h2v1h-2zM21 5h2v1h-2zM25 5h2v1h-2zM21 6h2v1h-2zM25 6h2v1h-2zM28 0h6v1h-6zM30 1h2v1h-2zM30 2h2v1h-2zM30 3h2v1h-2zM30 4h2v1h-2zM30 5h2v1h-2zM30 6h2v1h-2zM36 0h4v1h-4zM35 1h2v1h-2zM39 1h2v1h-2zM35 2h2v1h-2zM39 2h2v1h-2zM35 3h6v1h-6zM35 4h2v1h-2zM39 4h2v1h-2zM35 5h2v1h-2zM39 5h2v1h-2zM35 6h2v1h-2zM39 6h2v1h-2z"/>
                            <path class="pixel-face" fill="url(#wordmark-shade)" d="M1 0h5v1h-5zM0 1h2v1h-2zM0 2h2v1h-2zM1 3h4v1h-4zM4 4h2v1h-2zM4 5h2v1h-2zM0 6h5v1h-5zM7 0h6v1h-6zM9 1h2v1h-2zM9 2h2v1h-2zM9 3h2v1h-2zM9 4h2v1h-2zM9 5h2v1h-2zM9 6h2v1h-2zM14 0h5v1h-5zM14 1h2v1h-2zM18 1h2v1h-2zM14 2h2v1h-2zM18 2h2v1h-2zM14 3h5v1h-5zM14 4h2v1h-2zM17 4h2v1h-2zM14 5h2v1h-2zM18 5h2v1h-2zM14 6h2v1h-2zM18 6h2v1h-2zM22 0h4v1h-4zM21 1h2v1h-2zM25 1h2v1h-2zM21 2h2v1h-2zM25 2h2v1h-2zM21 3h6v1h-6zM21 4h2v1h-2zM25 4h2v1h-2zM21 5h2v1h-2zM25 5h2v1h-2zM21 6h2v1h-2zM25 6h2v1h-2zM28 0h6v1h-6zM30 1h2v1h-2zM30 2h2v1h-2zM30 3h2v1h-2zM30 4h2v1h-2zM30 5h2v1h-2zM30 6h2v1h-2zM36 0h4v1h-4zM35 1h2v1h-2zM39 1h2v1h-2zM35 2h2v1h-2zM39 2h2v1h-2zM35 3h6v1h-6zM35 4h2v1h-2zM39 4h2v1h-2zM35 5h2v1h-2zM39 5h2v1h-2zM35 6h2v1h-2zM39 6h2v1h-2z"/>
                        </svg>
                        <span class="masthead-label">Manual</span>
                        <p class="masthead-tagline">{{ description }}</p>
                    </div>
                    <!-- Label the masthead with the part the page belongs to. The first page, served
                         as both index.html and its own name, gets the large home masthead. -->
                    <script>
                        (function () {
                            const masthead = document.querySelector('.masthead');
                            const part = document.documentElement.getAttribute('data-part');
                            const first = document.querySelector('#sidebar a');
                            if (part) { masthead.querySelector('.masthead-label').textContent = part; }
                            if (first && first.classList.contains('active')) { masthead.classList.add('masthead-home'); }
                        })();
                    </script>

                    <main>
                        {{{ content }}}
                    </main>

                    <nav class="pager" aria-label="Page navigation">
                        {{#previous}}
                            <a rel="prev" href="{{ path_to_root }}{{link}}" class="nav-chapters previous" aria-keyshortcuts="Left">
                                <span class="pager-dir">← Previous</span>
                                <span class="pager-name">{{name}}</span>
                            </a>
                        {{/previous}}
                        {{#next}}
                            <a rel="next prefetch" href="{{ path_to_root }}{{link}}" class="nav-chapters next" aria-keyshortcuts="Right">
                                <span class="pager-dir">Next →</span>
                                <span class="pager-name">{{name}}</span>
                            </a>
                        {{/next}}
                    </nav>
                </div>
            </div>
        </div>

        {{#if live_reload_endpoint}}
        <!-- Livereload script (if served using the cli tool) -->
        <script>
            const wsProtocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
            const wsAddress = wsProtocol + "//" + location.host + "/" + "{{{live_reload_endpoint}}}";
            const socket = new WebSocket(wsAddress);
            socket.onmessage = function (event) {
                if (event.data === "reload") {
                    socket.close();
                    location.reload();
                }
            };

            window.onbeforeunload = function() {
                socket.close();
            }
        </script>
        {{/if}}

        {{#if search_js}}
        <script src="{{ resource "elasticlunr.min.js" }}"></script>
        <script src="{{ resource "mark.min.js" }}"></script>
        <script src="{{ resource "searcher.js" }}"></script>
        <!-- Search opens as an overlay, so keep the reader's place: searcher.js scrolls to
             the top on open. A click outside the palette closes it. -->
        <script>
            (function () {
                const wrapper = document.getElementById('search-wrapper');
                const scrollTo = window.scrollTo.bind(window);
                window.scrollTo = function (x, y) {
                    if (x === 0 && y === 0 && !wrapper.classList.contains('hidden')) { return; }
                    return scrollTo.apply(window, arguments);
                };
                wrapper.addEventListener('mousedown', function (e) {
                    if (e.target === wrapper) { document.getElementById('search-toggle').click(); }
                });
            })();
        </script>
        {{/if}}

        <script src="{{ resource "clipboard.min.js" }}"></script>
        <script src="{{ resource "highlight.js" }}"></script>
        <script src="{{ resource "book.js" }}"></script>

        {{#each additional_js}}
        <script src="{{ resource this}}"></script>
        {{/each}}

        {{#if is_print}}
        <script>
        window.addEventListener('load', function() {
            window.setTimeout(window.print, 100);
        });
        </script>
        {{/if}}

        {{#if fragment_map}}
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const fragmentMap =
                    {{{fragment_map}}}
                ;
                const target = fragmentMap[window.location.hash];
                if (target) {
                    let url = new URL(target, window.location.href);
                    window.location.replace(url.href);
                }
            });
        </script>
        {{/if}}

    </div>
    </body>
</html>
